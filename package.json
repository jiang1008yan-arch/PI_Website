{
  "name": "sales-portal",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev:api": "wrangler pages dev web/dist --compatibility-date=2025-04-01 --port 8788",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "deploy": "npm run build && wrangler pages deploy web/dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sales-portal-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sales-portal-db --remote",
    "typecheck": "tsc -p tsconfig.base.json --noEmit && npm --workspace web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "@remix-run/router": "^1.23.2",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.39.3",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "hono": "^4.7.4",
    "jose": "^6.0.8",
    "react-router": "^6.30.3",
    "react-router-dom": "^6.30.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250403.0",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.2"
  }
}
